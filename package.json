{
    "name": "forja",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "bin": {
        "forja": "./dist/cli.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "sandcastle": "tsx .sandcastle/main.mts",
        "dev": "concurrently -k -n server,web \"npm:dev:server\" \"vite\"",
        "dev:server": "tsx watch src/cli.ts --no-open",
        "build": "vite build && tsup",
        "start": "node dist/cli.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@dnd-kit/core": "^6.3.1",
        "@fastify/static": "^10.1.10",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slider": "^1.6.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-toast": "^1.3.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tanstack/react-query": "^5.106.1",
        "@tanstack/react-virtual": "^3.14.26",
        "@uiw/react-codemirror": "^4.25.12",
        "@xyflow/react": "^12.12.1",
        "better-sqlite3": "^13.0.3",
        "clsx": "^2.1.1",
        "croner": "^11.0.0",
        "diff": "^9.0.0",
        "drizzle-orm": "^0.45.4",
        "elkjs": "^0.12.1",
        "execa": "^10.2.1",
        "fastify": "^5.12.8",
        "fastify-type-provider-zod": "^7.0.0",
        "lucide-react": "^1.70.0",
        "open": "^11.0.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.7.0",
        "ulid": "^3.0.2",
        "yaml": "^2.9.1",
        "zod": "^4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@ai-hero/sandcastle": "^0.12.0",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/better-sqlite3": "^9.6.0",
        "@types/diff": "^7.0.2",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "concurrently": "^10.0.6",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^31.0.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.5",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.1.0"
    }
}
