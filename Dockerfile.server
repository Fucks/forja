# syntax=docker/dockerfile:1

# The image installs the same tarball `npm publish` would ship, so it runs what npx users run.
FROM node:22-bookworm-slim AS package
WORKDIR /forja
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm pack --pack-destination /tmp/package

FROM docker:27-cli AS docker-cli

FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates gh git hostname socat \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx \
    /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=package /tmp/package/*.tgz /tmp/forja.tgz
RUN npm install --global /tmp/forja.tgz && rm /tmp/forja.tgz
COPY scripts/server_entrypoint.sh /usr/local/bin/forja-server

# The container runs as the host user, whose home does not exist here; the CLIs need a writable one.
ENV HOME=/tmp/forja-home
ENV FORJA_PORT=4317
EXPOSE 4317
ENTRYPOINT ["forja-server"]
